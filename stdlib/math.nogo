# nogo math standard library
# import with: import "stdlib/math.nogo"

fn clamp(x, lo, hi) {
    if (x < lo) { return lo; }
    if (x > hi) { return hi; }
    return x;
}

fn lerp(a, b, t) {
    return a + (b - a) * t;
}

fn sign(x) {
    if (x > 0) { return 1; }
    if (x < 0) { return -1; }
    return 0;
}

fn gcd(a, b) {
    a = abs(a);
    b = abs(b);
    while (b != 0) {
        let tmp = b;
        b = a % b;
        a = tmp;
    }
    return a;
}

fn lcm(a, b) {
    return abs(a * b) // gcd(a, b);
}

fn is_prime(n) {
    if (n < 2) { return 0; }
    if (n == 2) { return 1; }
    if (n % 2 == 0) { return 0; }
    let i = 3;
    while (i * i <= n) {
        if (n % i == 0) { return 0; }
        i += 2;
    }
    return 1;
}

fn factorial(n) {
    if (n <= 1) { return 1; }
    return n * factorial(n - 1);
}

fn map_range(x, in_lo, in_hi, out_lo, out_hi) {
    return out_lo + (x - in_lo) * (out_hi - out_lo) / (in_hi - in_lo);
}

fn rand_int(lo, hi) {
    return lo + floor(random() * (hi - lo + 1));
}

fn rand_float(lo, hi) {
    return lo + random() * (hi - lo);
}
